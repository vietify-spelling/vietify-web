{
  "name": "vietify-web",
  "version": "0.1.0",
  "description": "Vietify as a static web app: give foreign pronunciation a Vietnamese-style spelling, fully in the browser.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "serve": "python3 -m http.server 8080 --directory public",
    "build:wasm": "wasm/build.sh",
    "export:rules": "python3 tools/export_rules.py",
    "export:golden": "python3 tools/make_golden.py"
  }
}
